# 日记数据路径配置示例
# 复制此文件为 .env 并修改为你的实际路径

# 日记文件夹根目录（包含 2004/, 2005/ 等年份文件夹）
DIARY_BASE_PATH=/path/to/your/diary/folder

# 数据库文件路径
DATABASE_PATH=/path/to/your/diary/folder/database_tools/diary_database.db

# LM Studio API 地址
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions

# ---- 年度日记回顾（scripts/yearly_review）----
# LM Studio OpenAI 兼容地址（只允许本机地址）
LLM_BASE_URL=http://127.0.0.1:1234/v1
# 对话模型 ID；留空则自动选择第一个非 embedding 模型（先运行 --models 确认实际名称）
LLM_MODEL=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
# 1=请求 JSON 模式（部分模型不支持，默认关闭）
LLM_JSON_MODE=0
# 保持 0：非本机地址会被直接拒绝，确保日记不出本机
ALLOW_REMOTE_LLM=0
