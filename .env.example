# 日记数据路径配置示例
# 复制此文件为 .env 并修改为你的实际路径

# 日记文件夹根目录（包含 2004/, 2005/ 等年份文件夹）
DIARY_BASE_PATH=/path/to/your/diary/folder

# 数据库文件路径
DATABASE_PATH=/path/to/your/diary/folder/database_tools/diary_database.db

# ---- 日记批量总结（scripts/batch_summary）----
# LM Studio OpenAI 兼容地址（只允许本机地址）
LLM_BASE_URL=http://127.0.0.1:1234/v1
# 对话模型 ID；留空则自动选择第一个非 embedding 模型（先运行 --models 确认实际名称）
LLM_MODEL=
# 单篇请求超时（秒）；摘要比事件标题长，默认比旧版宽松
LLM_TIMEOUT=180
# 推理模型（Qwen3 等）会先输出思考再输出正文：预算太小会把 token 全花在思考上，
# 导致 message.content 为空（finish_reason=length）
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# 1=请求 JSON 模式（部分模型不支持，默认关闭；摘要直接输出纯文本，不需要 JSON）
LLM_JSON_MODE=0
# 思考开关：none=关闭思考（推理模型推荐，快且省 token）；留空=不发送该参数
LLM_REASONING_EFFORT=none
# 注意：LLM_MAX_TOKENS 是"单次最多生成多少 token"，与 LM Studio 的 Context Length 无关。
#       关思考时实测输出仅 60~400 tokens，4096 已很充足；调大不会更快也不会更慢。
#       反而 Context Length 要按需设置：单篇 prompt 约 2000 tokens
#       （长日记会更大，见下方 CONTENT 截断说明），设成 8192~16384 即可；
#       设到几十万会显著拖慢推理并多吃显存。
# 保持 0：非本机地址会被直接拒绝，确保日记不出本机
ALLOW_REMOTE_LLM=0
# 运行期间每隔多少秒打印一次"人类可读状态块"（心跳）；默认 30 秒，最小 5 秒。
# 也可用命令行覆盖：--heartbeat 60，或 --no-heartbeat 关闭。
SUMMARY_HEARTBEAT_SECONDS=20

# 运行期间每隔多少秒刷新一次「中途预览.md」（运行目录里唯一的产物）：
# 全量跑要几小时，中途想先看结果就打开这个文件；跑完 / 中断后它会被重写为最终版。
# 默认 60 秒，最小 5 秒；0 = 关闭。也可用命令行覆盖：--preview-every 120 / --no-preview。
SUMMARY_PREVIEW_SECONDS=20

# 提示：旧版（年度日记回顾）用的 REVIEW_HEARTBEAT_SECONDS / REVIEW_PREVIEW_SECONDS
#       仍然兼容（新键没配置时读旧键）。

# ---- 情绪判断（batch 与 Web 共用同一份标签集）----
# 每篇日记在摘要之后额外发一次很短的调用，模型只回一个标签词；结果存进 SQLite，
# 网页端「日记摘要」页可按情绪筛选。
# 1=开启（默认）；0=只写摘要，不判断情绪（也可用命令行 --no-emotion / --emotion-only）
EMOTION_ENABLED=1
# 标签集：逗号（或中文逗号/顿号）分隔、保序去重；**最后一项是兜底标签**。
# 说明：
#   * 改这一行只会让「情绪」重新计算（可单独跑 --emotion-only 补），已跑完的摘要不受影响；
#   * 前端筛选下拉与后端参数校验都读这里，改完重启 webapp 即可生效；
#   * 情绪 Prompt 里的示例词是按默认 8 类写的，换标签集时建议同步看一眼
#     scripts/batch_summary/prompts/diary_emotion_prompt.txt。
EMOTION_LABELS=快乐,平淡,悲伤,生气,焦虑,疲惫,期待,其他
# 情绪判断的生成上限（只输出一个词，32 足够；留空/0 用默认）
LLM_EMOTION_MAX_TOKENS=32


# 摘要与正文长度（没有 .env 开关，需要改时编辑 scripts/batch_summary/config.py）：
#   MAX_SUMMARY_CHARS     = 60    单篇摘要硬上限（Prompt 要求 20~40 字、最多 50 字，超出按句读截断）
#   CONTENT_HEAD_CHARS    = 4000  超长正文保留前 4000 字
#   CONTENT_TAIL_CHARS    = 1000  超长正文保留后 1000 字
#   改大这两个值前，请先把 LM Studio 的 Context Length 一起调大，否则长日记会直接报错。
